    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "geolib": "4.0.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.4",
    "multer": "2.5.0",
    "pdfkit": "0.20.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
